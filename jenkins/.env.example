# Copiar a .env (NO subir .env al repositorio)
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=cambie-esta-clave
# Token de GitHub (classic) con scopes: repo:status, public_repo   — o fine-grained con
# Contents: read, Commit statuses: read/write, Pull requests: read, Metadata: read
GITHUB_USER=usuario-github
GITHUB_TOKEN=ghp_xxx
GITHUB_ORG=Taller-de-proyectos-2027-I
# Rama de devsecops-templates de donde se carga la librería y los scripts
DEVSECOPS_LIB_REF=jenkins/prototipo
