#!/bin/bash
# Arranque de la instancia de staging: instala Docker y ejecuta la imagen de ECR.
set -euo pipefail
dnf install -y docker
systemctl enable --now docker
aws ecr get-login-password --region ${aws_region} | docker login --username AWS --password-stdin ${registry}
docker run -d --restart unless-stopped --name app -p ${app_port}:${app_port} \
  -e SERVER_PORT=${app_port} -e SPRING_PROFILES_ACTIVE=staging \
  ${image_uri}
